{
  "$defs": {
    "CurveballMode": {
      "properties": {
        "kinds": {
          "default": [],
          "items": {
            "enum": [
              "time_crunch",
              "slides_down",
              "heckler",
              "latecomer",
              "bait",
              "distraction",
              "vip_arrives",
              "crosstalk",
              "fact_check",
              "elevator",
              "plain_language",
              "dead_room"
            ],
            "type": "string"
          },
          "title": "Kinds",
          "type": "array"
        },
        "mode": {
          "default": "surprise",
          "enum": [
            "off",
            "surprise",
            "choose"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "CurveballMode",
      "type": "object"
    },
    "CurveballReport": {
      "properties": {
        "at_ms": {
          "title": "At Ms",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "time_crunch",
            "slides_down",
            "heckler",
            "latecomer",
            "bait",
            "distraction",
            "vip_arrives",
            "crosstalk",
            "fact_check",
            "elevator",
            "plain_language",
            "dead_room"
          ],
          "title": "Kind",
          "type": "string"
        },
        "recovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/Recovery"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution": {
          "enum": [
            "auto_restored",
            "presenter_restored",
            "answered",
            "skipped",
            "timed_out"
          ],
          "title": "Resolution",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "at_ms",
        "resolution",
        "recovery"
      ],
      "title": "CurveballReport",
      "type": "object"
    },
    "Deck": {
      "properties": {
        "deck_id": {
          "title": "Deck Id",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "page_count": {
          "title": "Page Count",
          "type": "integer"
        },
        "slides": {
          "items": {
            "$ref": "#/$defs/Slide"
          },
          "title": "Slides",
          "type": "array"
        }
      },
      "required": [
        "deck_id",
        "filename",
        "page_count",
        "slides"
      ],
      "title": "Deck",
      "type": "object"
    },
    "FollowUpVerdict": {
      "properties": {
        "line": {
          "title": "Line",
          "type": "string"
        },
        "missing_detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Detail"
        },
        "verdict": {
          "enum": [
            "satisfied",
            "follow_up"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "line"
      ],
      "title": "FollowUpVerdict",
      "type": "object"
    },
    "Improvement": {
      "properties": {
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "observation": {
          "title": "Observation",
          "type": "string"
        },
        "suggestion": {
          "title": "Suggestion",
          "type": "string"
        }
      },
      "required": [
        "observation",
        "evidence",
        "suggestion"
      ],
      "title": "Improvement",
      "type": "object"
    },
    "KeyMoment": {
      "properties": {
        "at_ms": {
          "title": "At Ms",
          "type": "integer"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "time_crunch",
                "slides_down",
                "heckler",
                "latecomer",
                "bait",
                "distraction",
                "vip_arrives",
                "crosstalk",
                "fact_check",
                "elevator",
                "plain_language",
                "dead_room"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "persona_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Persona Id"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "type": {
          "enum": [
            "question",
            "curveball",
            "answer",
            "phase"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "at_ms",
        "type",
        "summary"
      ],
      "title": "KeyMoment",
      "type": "object"
    },
    "OrchestratorDecision": {
      "properties": {
        "action": {
          "enum": [
            "none",
            "question",
            "curveball"
          ],
          "title": "Action",
          "type": "string"
        },
        "cited_transcript_excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cited Transcript Excerpt"
        },
        "curveball_kind": {
          "anyOf": [
            {
              "enum": [
                "time_crunch",
                "slides_down",
                "heckler",
                "latecomer",
                "bait",
                "distraction",
                "vip_arrives",
                "crosstalk",
                "fact_check",
                "elevator",
                "plain_language",
                "dead_room"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Curveball Kind"
        },
        "line": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "persona_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Persona Id"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "slide_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slide Number"
        }
      },
      "required": [
        "action",
        "reason"
      ],
      "title": "OrchestratorDecision",
      "type": "object"
    },
    "PanelReply": {
      "description": "A conversational turn: the presenter spoke to the panel, one panelist answers.",
      "properties": {
        "line": {
          "title": "Line",
          "type": "string"
        },
        "persona_id": {
          "title": "Persona Id",
          "type": "string"
        }
      },
      "required": [
        "persona_id",
        "line"
      ],
      "title": "PanelReply",
      "type": "object"
    },
    "Persona": {
      "properties": {
        "avatar_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Avatar Url"
        },
        "custom": {
          "default": false,
          "title": "Custom",
          "type": "boolean"
        },
        "focus": {
          "items": {
            "type": "string"
          },
          "title": "Focus",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "plays": {
          "default": [],
          "items": {
            "enum": [
              "time_crunch",
              "slides_down",
              "heckler",
              "latecomer",
              "bait",
              "distraction",
              "vip_arrives",
              "crosstalk",
              "fact_check",
              "elevator",
              "plain_language",
              "dead_room"
            ],
            "type": "string"
          },
          "title": "Plays",
          "type": "array"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "skepticism": {
          "maximum": 1,
          "minimum": 0,
          "title": "Skepticism",
          "type": "number"
        },
        "style_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style Hint"
        },
        "voice_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voice Id"
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "focus",
        "skepticism"
      ],
      "title": "Persona",
      "type": "object"
    },
    "PersonaFeedback": {
      "properties": {
        "comment": {
          "title": "Comment",
          "type": "string"
        },
        "persona_id": {
          "title": "Persona Id",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        }
      },
      "required": [
        "persona_id",
        "comment"
      ],
      "title": "PersonaFeedback",
      "type": "object"
    },
    "Preset": {
      "properties": {
        "curveballs_allowed": {
          "items": {
            "enum": [
              "time_crunch",
              "slides_down",
              "heckler",
              "latecomer",
              "bait",
              "distraction",
              "vip_arrives",
              "crosstalk",
              "fact_check",
              "elevator",
              "plain_language",
              "dead_room"
            ],
            "type": "string"
          },
          "title": "Curveballs Allowed",
          "type": "array"
        },
        "default_difficulty": {
          "default": "normal",
          "enum": [
            "friendly",
            "normal",
            "brutal"
          ],
          "title": "Default Difficulty",
          "type": "string"
        },
        "duration_target_s": {
          "default": 180,
          "title": "Duration Target S",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "personas": {
          "items": {
            "type": "string"
          },
          "title": "Personas",
          "type": "array"
        },
        "tagline": {
          "default": "",
          "title": "Tagline",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "personas",
        "curveballs_allowed"
      ],
      "title": "Preset",
      "type": "object"
    },
    "Recovery": {
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "resume_after_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resume After Ms"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        }
      },
      "title": "Recovery",
      "type": "object"
    },
    "RecoveryAssessment": {
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "observation": {
          "title": "Observation",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "suggestion": {
          "title": "Suggestion",
          "type": "string"
        }
      },
      "required": [
        "observation",
        "suggestion"
      ],
      "title": "RecoveryAssessment",
      "type": "object"
    },
    "Report": {
      "properties": {
        "curveballs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CurveballReport"
          },
          "title": "Curveballs",
          "type": "array"
        },
        "dimensions": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Dimensions",
          "type": "object"
        },
        "improvements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Improvement"
          },
          "title": "Improvements",
          "type": "array"
        },
        "key_moments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/KeyMoment"
          },
          "title": "Key Moments",
          "type": "array"
        },
        "metric_caveats": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Metric Caveats",
          "type": "array"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "overall_score": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overall Score"
        },
        "persona_feedback": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PersonaFeedback"
          },
          "title": "Persona Feedback",
          "type": "array"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "strengths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Strengths",
          "type": "array"
        }
      },
      "required": [
        "session_id",
        "dimensions",
        "metrics"
      ],
      "title": "Report",
      "type": "object"
    },
    "SessionConfig": {
      "properties": {
        "curveballs": {
          "$ref": "#/$defs/CurveballMode",
          "default": {
            "kinds": [],
            "mode": "surprise"
          }
        },
        "deck_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deck Id"
        },
        "difficulty": {
          "default": "normal",
          "enum": [
            "friendly",
            "normal",
            "brutal"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "duration_target_s": {
          "default": 180,
          "title": "Duration Target S",
          "type": "integer"
        },
        "input_mode": {
          "default": "live",
          "enum": [
            "live",
            "push_to_talk"
          ],
          "title": "Input Mode",
          "type": "string"
        },
        "interruption_frequency": {
          "default": "normal",
          "enum": [
            "rare",
            "normal",
            "often"
          ],
          "title": "Interruption Frequency",
          "type": "string"
        },
        "personas": {
          "items": {
            "$ref": "#/$defs/Persona"
          },
          "maxItems": 3,
          "minItems": 2,
          "title": "Personas",
          "type": "array"
        },
        "preset_id": {
          "title": "Preset Id",
          "type": "string"
        },
        "qna_questions": {
          "default": 2,
          "maximum": 3,
          "minimum": 0,
          "title": "Qna Questions",
          "type": "integer"
        }
      },
      "required": [
        "preset_id",
        "personas"
      ],
      "title": "SessionConfig",
      "type": "object"
    },
    "SessionEvent": {
      "properties": {
        "payload": {
          "additionalProperties": true,
          "default": {},
          "title": "Payload",
          "type": "object"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "timestamp_ms": {
          "title": "Timestamp Ms",
          "type": "integer"
        },
        "type": {
          "enum": [
            "session_started",
            "slide_changed",
            "transcript_segment",
            "question_queued",
            "ai_speech_started",
            "ai_speech_ended",
            "answer_received",
            "curveball_triggered",
            "curveball_resolved",
            "timer_override",
            "paused",
            "resumed",
            "skipped",
            "avatar_status",
            "audio_status",
            "phase_changed",
            "session_ended",
            "error"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "session_id",
        "timestamp_ms"
      ],
      "title": "SessionEvent",
      "type": "object"
    },
    "Slide": {
      "properties": {
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "number",
        "text"
      ],
      "title": "Slide",
      "type": "object"
    },
    "TranscriptSegment": {
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "end_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "speaker": {
          "default": "presenter",
          "enum": [
            "presenter",
            "ai"
          ],
          "title": "Speaker",
          "type": "string"
        },
        "start_ms": {
          "title": "Start Ms",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start_ms",
        "text"
      ],
      "title": "TranscriptSegment",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
