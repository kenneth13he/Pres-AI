# Copy to .env (never committed). Configure only the keys for your selected adapters.
BOSON_API_KEY=
BOSON_REALTIME_MODEL=higgs-realtime
BOSON_TTS_MODEL=higgs-tts-3
BOSON_STT_MODEL=higgs-stt-3.1
BOSON_AVATAR_ENABLED=false
BOSON_REASONING_MODEL=higgs-realtime
BOSON_REASONING_MAX_OUTPUT_TOKENS=768
BOSON_REASONING_MAX_REQUESTS=200
BOSON_SPEND_CARRYOVER_USD=0

ANTHROPIC_API_KEY=
ORCHESTRATOR_MODEL=claude-opus-5-5
ORCHESTRATOR_TIMEOUT_S=8
ORCHESTRATOR_SLOW_TIMEOUT_S=15

# Offline default. Set "higgs" to use the verified Boson microphone/voice path.
VOICE_ADAPTER=mock
# "mock" for offline work; "boson" uses the existing Boson key; "claude" needs Anthropic.
ORCHESTRATOR=mock

CURVEBALLS_ENABLED=true
DEBUG_CURVEBALL_ENDPOINT=false
SPEND_SOFT_CAP_USD=60
PORT=8000
