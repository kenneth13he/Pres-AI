# Copy to .env (never committed). Two keys; never paste either into chat, a commit or a screenshot.
BOSON_API_KEY=
BOSON_REALTIME_MODEL=higgs-realtime
BOSON_TTS_MODEL=higgs-tts-3
BOSON_STT_MODEL=higgs-stt-3.1
BOSON_AVATAR_ENABLED=false

ANTHROPIC_API_KEY=
ORCHESTRATOR_MODEL=claude-opus-5-5
ORCHESTRATOR_TIMEOUT_S=8
ORCHESTRATOR_SLOW_TIMEOUT_S=15

# "mock" until Person B's hour-1 tests pick a shape (CLAUDE.md §13); then "higgs".
VOICE_ADAPTER=mock
# "mock" for deterministic tests and offline frontend work; "claude" for real sessions.
ORCHESTRATOR=mock

CURVEBALLS_ENABLED=true
DEBUG_CURVEBALL_ENDPOINT=true
SPEND_SOFT_CAP_USD=60
PORT=8000
